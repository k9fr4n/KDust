# ---- Application gate (mono-user) ----
# Laisser vide pour désactiver la gate (déconseillé même en local).
APP_PASSWORD=change-me

# Clé de chiffrement AES-256-GCM (32 octets base64).
# Générer : openssl rand -base64 32
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Secret pour signer le cookie de session applicative.
# Générer : openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTES

# ---- Dust / WorkOS (valeurs par défaut surchargeables via /settings) ----
DUST_BASE_URL=https://dust.tt
WORKOS_CLIENT_ID=client_01JGCT55T7FVDG9XF74925R1KT
WORKOS_DOMAIN=api.workos.com
WORKOS_CLAIM_NAMESPACE=https://dust.tt/

# ---- Telegram (notifications + interactive chat bridge) ----
# Bot token from @BotFather. Used for both:
#   - outbound run-completion notifications (always on when set)
#   - the interactive chat bridge (additionally gated by
#     /settings/telegram \u2192 "Enable Telegram chat bridge")
# Empty = both flows are disabled.
KDUST_TELEGRAM_BOT_TOKEN=

# ---- DB / runtime ----
DATABASE_URL=file:/data/kdust.db
NODE_ENV=production

# Task attachments (Franck 2026-05-09).
# Root directory for Task attachment blobs. Files are re-uploaded
# to Dust on every run — this is just the local persistence root.
# Default = /projects/.kdust-attachments
KDUST_ATTACHMENTS_DIR=

# ---- code-server IDE (ADR-0028, Franck 2026-06-03) ----
# Browser VS Code scoped to /projects, embedded at /ide and reached
# through the KDust auth-proxy (port 4001, kdust_session JWT-gated).
# Since ADR-0029 code-server runs INSIDE the kdust container (no
# sidecar) so the terminal has the full agent toolchain (docker, gh,
# glab, kdust-claude). [SECURITY] this means the IDE terminal shares
# docker.sock = host root via DooD — same surface as the agent runtime.
# ON BY DEFAULT — set to false to disable (kill switch).
IDE_ENABLED=true
# Public base URL the browser uses to reach the IDE proxy. Leave empty
# to derive <current-host>:4001 client-side (simplest setup). Set it
# when KDust sits behind a TLS reverse-proxy, e.g.
# https://kdust.example.com:4001 (same host as KDust so the
# kdust_session cookie is sent). When you enable IDE_TLS_* below, set
# this to https://<host>:4001 so the "Open in IDE" link uses https.
IDE_PUBLIC_URL=

# ---- IDE TLS (Franck 2026-06-03) ----
# [REQUIRED for code-server webviews] The Claude Code chat panel,
# extension READMEs and the settings UI are rendered by a service
# worker. Browsers only register service workers in a *secure context*
# (HTTPS or localhost), so over plain HTTP on a LAN IP (e.g.
# http://192.168.0.3:4001) those webviews stay BLANK while the rest of
# the editor works. Terminating TLS on the proxy fixes it.
#
# Point these at a PEM keypair under ./data (already bind-mounted to
# /data). Generate a self-signed one for your host with:
#   ./scripts/gen-ide-cert.sh 192.168.0.3
# then set both vars + IDE_PUBLIC_URL=https://192.168.0.3:4001 and
# restart the kdust container. Leave empty to keep plain HTTP.
IDE_TLS_CERT=
IDE_TLS_KEY=
