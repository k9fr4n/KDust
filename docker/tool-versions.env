# Single source of truth for the manually-pinned CLI tools baked into the
# KDust runner image (ADR-0032). Bump a version HERE — never inside the
# Dockerfile. docker/install-tools.sh consumes these values at build time.
#
# Rules:
#   * Numeric versions only (NO leading "v"). The "v" prefix, where the
#     upstream release tag needs one, is added by install-tools.sh per tool.
#   * Keep this file POSIX-shell sourceable: NAME=value, no spaces, no quotes.
#
# Tools installed via apt repos (docker-ce-cli, gh, git, python3, ...) are
# NOT listed here: apt tracks their upstream repo and they refresh on rebuild.
# claude-code is intentionally absent too — it installs @latest and self-updates
# at runtime (ADR-0027).

# yq — Mike Farah's Go YAML processor (github.com/mikefarah/yq), tag v<VER>
YQ_VERSION=4.53.3

# glab — GitLab CLI (gitlab.com/gitlab-org/cli), release v<VER>, .deb asset
GLAB_VERSION=1.94.0

# ruff — Astral Python linter/formatter (github.com/astral-sh/ruff), tag <VER> (no v)
RUFF_VERSION=0.15.16

# uv / uvx — Astral Python package manager (github.com/astral-sh/uv), tag <VER> (no v)
UV_VERSION=0.11.19

# code-server — Coder web IDE (github.com/coder/code-server), tag v<VER>
CODE_SERVER_VERSION=4.123.0

# @devcontainers/cli — npm global (Dev Containers CLI)
DEVCONTAINERS_CLI_VERSION=0.87.0
